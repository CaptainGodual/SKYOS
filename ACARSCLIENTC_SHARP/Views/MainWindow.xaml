<Window x:Class="SKYOS_ACARS_Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SKYOS ACARS - Flight Operations"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2362D9" Padding="15">
            <TextBlock Text="SKYOS ACARS - Flight Operations Dashboard" 
                       Foreground="White" FontSize="20" FontWeight="Bold"/>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Flight List -->
            <Border Grid.Column="0" BorderThickness="1" BorderBrush="#CCC" Padding="10">
                <StackPanel>
                    <TextBlock Text="My Flights" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    
                    <DataGrid x:Name="FlightsDataGrid" AutoGenerateColumns="False" 
                              SelectionMode="Single" MaxHeight="400">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Flight" Binding="{Binding FlightNumber}" Width="80"/>
                            <DataGridTextColumn Header="Departure" Binding="{Binding Departure}" Width="70"/>
                            <DataGridTextColumn Header="Arrival" Binding="{Binding Arrival}" Width="70"/>
                            <DataGridTextColumn Header="Aircraft" Binding="{Binding Aircraft}" Width="100"/>
                            <DataGridTextColumn Header="Scheduled" Binding="{Binding ScheduledAt}" Width="130"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="ACARS" Binding="{Binding AcarsStatus}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button x:Name="RefreshButton" Content="Refresh Flights" 
                            Click="RefreshButton_Click" Margin="0,10,0,0"
                            Background="#2362D9" Foreground="White" Height="35"/>
                </StackPanel>
            </Border>

            <!-- Right Panel: Actions -->
            <Border Grid.Column="1" BorderThickness="1" BorderBrush="#CCC" Padding="20">
                <StackPanel>
                    <TextBlock Text="Flight Actions" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <TextBlock Text="Select a flight from the list on the left" 
                               FontStyle="Italic" Foreground="#666" Margin="0,0,0,20"/>

                    <StackPanel x:Name="FlightActionsPanel" IsEnabled="False">
                        <TextBlock Text="Flight Events" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <Button x:Name="TakeoffButton" Content="Take Off" Height="40" 
                                Margin="0,0,0,10" Background="#28A745" Foreground="White"
                                Click="TakeoffButton_Click"/>

                        <Button x:Name="LandButton" Content="Land / Complete" Height="40" 
                                Margin="0,0,0,10" Background="#DC3545" Foreground="White"
                                Click="LandButton_Click"/>

                        <Button x:Name="CancelButton" Content="Cancel Flight" Height="40" 
                                Margin="0,0,0,10" Background="#FFC107" Foreground="Black"
                                Click="CancelButton_Click"/>

                        <TextBlock Text="Telemetry" FontWeight="SemiBold" Margin="0,20,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Altitude (ft):" Width="100"/>
                            <TextBox x:Name="AltitudeTextBox" Width="100" Text="35000"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Ground Speed (kts):" Width="100"/>
                            <TextBox x:Name="GroundSpeedTextBox" Width="100" Text="450"/>
                        </StackPanel>

                        <TextBlock Text="File PIREP" FontWeight="SemiBold" Margin="0,20,0,10"/>

                        <TextBox x:Name="PirepRemarksTextBox" Height="60" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <Button x:Name="FilePirepButton" Content="File PIREP" Height="40" 
                                Background="#17A2B8" Foreground="White"
                                Click="FilePirepButton_Click"/>
                    </StackPanel>

                    <Button x:Name="LogoutButton" Content="Logout" Height="40" 
                            Margin="0,30,0,0" Background="#6C757D" Foreground="White"
                            Click="LogoutButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
