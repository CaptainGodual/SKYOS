# ---------------------------------------------------------------------------
# SKYOS Crew Center — production environment template
# Copy to .env on the server, then: php artisan key:generate
# Never commit the real .env (it is already in .gitignore).
# ---------------------------------------------------------------------------

APP_NAME="SKYOS Crew Center"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crew.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (use MySQL/PostgreSQL in production, not SQLite) --------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skyos
DB_USERNAME=skyos
DB_PASSWORD=

# --- Sessions / cache / queue ----------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail (a real transport — 'log' silently swallows messages) ------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="ops@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- First administrator bootstrap (read by DatabaseSeeder) ----------------
SKYOS_ADMIN_NAME="Crew Administrator"
SKYOS_ADMIN_EMAIL=ops@example.com
SKYOS_ADMIN_PASSWORD=

# --- Outbound webhook for flight events ------------------------------------
# Leave blank to queue events locally ('Awaiting configuration') instead of POSTing.
SKYOS_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"
