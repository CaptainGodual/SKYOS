# ---------------------------------------------------------------------------
# SKYOS Crew Center — production environment template
# Copy to .env on the server, then: php artisan key:generate
# Never commit the real .env (it is already in .gitignore).
# ---------------------------------------------------------------------------

APP_NAME="SKYOS Crew Center"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crew.skywardairvirtual.online

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (use MySQL/PostgreSQL in production, not SQLite) --------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skyos
DB_USERNAME=skyos
DB_PASSWORD=

# --- Sessions / cache / queue ----------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail (a real transport — 'log' silently swallows messages) ------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="ops@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- First administrator bootstrap -----------------------------------------
# There is nothing to seed: create the first administrator after migrating with
#   php artisan app:create-admin
# (it prompts for the password without echoing it, and stores only a bcrypt hash).

# --- Outbound webhook for flight events ------------------------------------
# Set a Discord webhook URL to post flight events to a channel. Leave it blank
# to queue events locally ('Awaiting configuration') instead of POSTing.
DISCORD_WEBHOOK_URL=

# --- Crew center limits ----------------------------------------------------
# How many flights a pilot may hold at once. Set to 0 for no limit.
SKYOS_MAX_BOOKED_FLIGHTS=3
# Ticket revenue booked per accepted PIREP, as a multiple of the pilot payout.
# Set to 0 to record no revenue at all.
SKYOS_REVENUE_MULTIPLIER=1.5

VITE_APP_NAME="${APP_NAME}"
